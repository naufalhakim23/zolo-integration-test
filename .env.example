APP_NAME="zolo-test"
APP_ENV="development"
APP_PORT="8080"

# Both tenants point at the same mock process locally. In a real deployment
# these are the tenants' own ERP hosts.
ERP_ALPHA_BASE_URL="http://localhost:9090"
ERP_BETA_BASE_URL="http://localhost:9090"
ERP_TIMEOUT="10s"
ERP_MAX_ATTEMPTS="4"
ERP_BACKOFF_BASE="100ms"
ERP_BACKOFF_MAX="2s"
